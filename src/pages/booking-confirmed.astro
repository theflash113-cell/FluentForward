---
// Shown after the booking form is sent without JavaScript (or from a link).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { booking, contact, prices } from '../lib/settings';
const cal = booking.google_calendar_link?.trim();
---
<Base title="Thanks! Now pick a time" description="Your answers were sent to Kyle. Next step: pick a time for your free intro call." noindex>
  <section class="section section--surface">
    <div class="container confirm">
      <span class="confirm__icon"><Icon name="check" size={36} /></span>
      <h1 class="t-display-l">Thanks! Your answers are in.</h1>
      <p class="t-body-l c-secondary">Kyle has your focus, level and goals. One last step: pick a time for your free {prices.intro_call_minutes}-minute intro call.</p>
      <div class="confirm__ctas">
        {cal ? (
          <Button href={cal} variant="accent" size="lg" iconLeft="calendar" icon={false} external>Pick a time</Button>
        ) : (
          <a class="btn btn--whatsapp btn--lg" href={contact.whatsappUrl("Hi Kyle! I just sent my booking answers on your website. When could we do the free intro call?")} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>Message Kyle to pick a time</span></a>
        )}
        <Button href={contact.emailUrl} variant="secondary" size="lg" iconLeft="mail" icon={false}>Email instead</Button>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="t-h1 next__title">What happens next</h2>
      <ol class="next" role="list">
        <li><span class="next__n">1</span><h3 class="t-h4">Before the call</h3><p class="t-body-m c-secondary">Think about your goals: work, travel, exams? What do you find hardest in English?</p></li>
        <li><span class="next__n">2</span><h3 class="t-h4">On the call</h3><p class="t-body-m c-secondary">We'll chat for {prices.intro_call_minutes} minutes, check your level and plan your first lesson.</p></li>
        <li><span class="next__n">3</span><h3 class="t-h4">After the call</h3><p class="t-body-m c-secondary">I'll send you a payment link for your first lesson or package. No pressure!</p></li>
      </ol>
      <p class="t-body-m c-secondary next__note">Need to change something? Reschedule or cancel for free up to {booking.cancellation_notice_hours} hours before. Questions? <a href={contact.whatsappUrl()} target="_blank" rel="noopener">Message me on WhatsApp</a>.</p>
    </div>
  </section>
</Base>
<style>
  .confirm { max-width: 760px; display: grid; justify-items: center; text-align: center; gap: 20px; }
  .confirm__icon { width: 72px; height: 72px; border-radius: 50%; background: var(--ff-bg-brand); color: #fff; display: grid; place-items: center; box-shadow: var(--ff-shadow-pop-sm); }
  .confirm__ctas { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .next__title { margin-bottom: 32px; }
  .next { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 0; }
  @media (max-width: 760px) { .next { grid-template-columns: 1fr; } }
  .next li { display: grid; gap: 10px; align-content: start; padding: 24px; border: 1px solid var(--ff-border-default); border-radius: var(--ff-radius-lg); }
  .next__n { width: 36px; height: 36px; border-radius: 50%; background: var(--ff-bg-accent); display: grid; place-items: center; font-weight: 600; }
  .next__note { margin-top: 32px; }
</style>
