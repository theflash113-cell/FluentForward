---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Newsletter from '../components/Newsletter.astro';
const items = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Free English resources" description="Free English worksheets and guides from Fluent Forward: download, print and practice.">
  <section class="section section--surface">
    <div class="container">
      <SectionHead as="h1" size="display" overline="Free resources" title="Free English worksheets & guides" lead="Download, print and practice. Made in the same style as my lessons." />
      {items.length === 0 ? (
        <ComingSoon source="resources" items={['All 12 tenses: one-page cheat sheet', 'Conditionals practice pack with answer key', '50 business phrases for meetings and emails', 'Travel English survival kit']} />
      ) : (
        <>
          <ul class="res" role="list">
            {items.map((r) => (
              <li class="res__card">
                <span class="icon-badge"><Icon name="book" /></span>
                <h2 class="t-h4">{r.data.title}</h2>
                <p class="t-body-s c-secondary">{r.data.description}</p>
                {r.data.level && <span class="tag tag--neutral">{r.data.level}</span>}
                <a class="btn btn--primary" href={`/resources/${r.data.file}`} download><span>Download PDF</span><Icon name="arrow-right" /></a>
              </li>
            ))}
          </ul>
          <div class="nl"><h2 class="t-h3">Get new resources by email</h2><Newsletter source="resources" /></div>
        </>
      )}
    </div>
  </section>
</Base>
<style>
  .res { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 1024px) { .res { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .res { grid-template-columns: 1fr; } }
  .res__card { display: grid; gap: 12px; justify-items: start; align-content: start; padding: 24px; background: #fff; border: 1px solid var(--ff-border-default); border-radius: var(--ff-radius-lg); }
  .res__card .btn { margin-top: 8px; }
  .nl { margin-top: 48px; display: grid; gap: 16px; }
</style>
