---
// Private lesson booking for current students.
// The Netlify edge function in netlify/edge-functions/students.js checks the
// student's code and fills in this page: it swaps data-access="locked" for
// "open" and puts the calendar link in place of the placeholder below (or
// about:blank when locked). The built page never contains the link itself.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { booking, contact } from '../lib/settings';
const askForCode = contact.whatsappUrl("Hi Kyle! Could you send me my student booking code?");
---
<Base title="Book a lesson" description="Lesson booking for current Fluent Forward students. Enter the student code Kyle sent you to pick a lesson time.">
  <section class="section section--surface students" data-access="locked" data-code-error="0">
    <div class="container students__gate">
      <span class="students__icon"><Icon name="calendar" size={32} /></span>
      <h1 class="t-display-l">Book your next lesson</h1>
      <p class="t-body-l c-secondary">This page is for current students. Enter the code Kyle sent you. You only need to do this once on each device.</p>
      <form class="students__form" method="POST" action="/students/">
        <div class="field">
          <label for="code">Your student code</label>
          <input id="code" name="code" class="input" autocomplete="off" autocapitalize="characters" spellcheck="false" required placeholder="e.g. EMRE-7K2P" aria-describedby="code-error" />
          <p class="error-msg students__error" id="code-error" aria-live="polite">That code didn't work. Check it and try again, or message Kyle for a new one.</p>
        </div>
        <Button type="submit" variant="accent" size="lg" block>Continue</Button>
      </form>
      <p class="t-body-m c-secondary">New here? <a href="/pricing/#book">Book a free intro call</a> first. Lost your code? <a href={askForCode} target="_blank" rel="noopener">Message Kyle on WhatsApp</a>.</p>
    </div>

    <div class="container students__open">
      <h1 class="t-display-l">Book your next lesson</h1>
      <p class="t-body-l c-secondary">Pick a time that works for you. Need to change a booking? Reschedule or cancel for free up to {booking.cancellation_notice_hours} hours before.</p>
      <div class="students__calendar"><iframe src="__STUDENT_CALENDAR_URL__" title="Pick a lesson time with Google Calendar"></iframe></div>
      <p class="t-body-s c-secondary">Questions? <a href={contact.whatsappUrl()} target="_blank" rel="noopener">Message Kyle on WhatsApp</a>. Not you? <a href="/students/?signout">Use a different code</a>.</p>
    </div>
  </section>
</Base>
<style>
  .students__gate { max-width: 560px; display: grid; justify-items: center; text-align: center; gap: 20px; }
  .students__icon { width: 72px; height: 72px; border-radius: 50%; background: var(--ff-bg-brand); color: #fff; display: grid; place-items: center; box-shadow: var(--ff-shadow-pop-sm); }
  .students__form { width: 100%; display: grid; gap: 16px; text-align: left; }
  .students__error { display: none; }
  [data-code-error='1'] .students__error { display: block; }
  .students__open { display: none; gap: 20px; max-width: 900px; }
  [data-access='open'] .students__gate { display: none; }
  [data-access='open'] .students__open { display: grid; }
  .students__calendar { background: #fff; border-radius: var(--ff-radius-lg); border: 1px solid var(--ff-border-default); overflow: hidden; }
  .students__calendar iframe { width: 100%; height: 720px; border: 0; }
</style>
