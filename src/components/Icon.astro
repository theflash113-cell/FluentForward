---
import { icons, whatsappPath } from '../lib/icons';
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls, label } = Astro.props;
const isWa = name === 'whatsapp';
---
{isWa ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d={whatsappPath} /></svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d={icons[name] ?? icons['chevron-right']} /></svg>
)}
