---
// Figma: Video Embed (56:44). Click-to-load, privacy-friendly YouTube.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import poster from '../assets/photos/kyle-headshot.jpg';
import { contact } from '../lib/settings';
interface Props { caption?: string }
const { caption = 'Watch: Meet Kyle' } = Astro.props;
const id = contact.youtube_intro_video_id;
---
<div class="video" data-video-id={id}>
  <button type="button" class="video__btn" aria-label={`${caption} (play video)`}>
    <Image src={poster} alt="" widths={[480, 720]} sizes="(max-width: 900px) 100vw, 640px" class="video__poster" />
    <span class="video__shade"></span>
    <span class="video__play"><Icon name="play" size={32} /></span>
    <span class="video__caption t-label-l">{caption}</span>
  </button>
  <noscript><a href={contact.youtubeUrl}>Watch the video on YouTube</a></noscript>
</div>
<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--ff-radius-xl); overflow: hidden; background: #000; }
  .video__btn { all: unset; position: absolute; inset: 0; cursor: pointer; }
  .video__btn:focus-visible { outline: 3px solid var(--ff-border-focus); outline-offset: -3px; }
  .video__poster { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .video__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,20,51,.1), rgba(15,20,51,.55)); }
  .video__play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 80px; height: 80px; border-radius: 50%; background: var(--ff-bg-accent); color: var(--ff-text-on-accent); display: grid; place-items: center; box-shadow: var(--ff-shadow-pop-sm); transition: scale .15s; }
  .video__play :global(svg) { fill: currentColor; margin-left: 4px; }
  .video__btn:hover .video__play { scale: 1.06; }
  .video__caption { position: absolute; left: 24px; bottom: 20px; color: #fff; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.video[data-video-id]').forEach((wrap) => {
    wrap.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${wrap.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = 'Meet Kyle: intro video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      wrap.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
